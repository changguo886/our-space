"use client";

import {
  ArrowRight,
  LoaderCircle,
} from "lucide-react";

import {
  useState,
} from "react";

import {
  useRouter,
} from "next/navigation";

import TodoList, {
  type Todo,
} from "@/components/TodoList";

import {
  createClient,
} from "@/lib/supabase/client";


type OverdueTodoListProps = {
  todos: Todo[];

  /*
   * 服务端已经按照用户 profile timezone
   * 计算好的“今天”。
   *
   * 例如：
   * 2026-10-06
   */
  todayDate: string;
};


/**
 * OverdueTodoList
 *
 * 专门负责“之前没完成”的 Todo。
 *
 * 和普通 TodoList 的区别只有一个：
 * 每个过期 Todo 多一个「移到今天」按钮。
 *
 * 点击后只更新：
 *
 * todos.task_date = todayDate
 *
 * 不修改：
 * - scheduled_start
 * - scheduled_end
 * - todo_sessions
 * - started_at
 * - elapsed_seconds
 * - Quick Notes
 */
export default function OverdueTodoList({
  todos,
  todayDate,
}: OverdueTodoListProps) {
  const router =
    useRouter();

  /*
   * 正在移动的 Todo。
   *
   * 用于按钮 loading，
   * 防止用户连续重复点击。
   */
  const [
    movingId,
    setMovingId,
  ] =
    useState<
      string | null
    >(null);

  /*
   * 成功移动后先从当前 UI 隐藏。
   *
   * router.refresh() 会随后重新从服务端读取：
   *
   * overdueTodos
   *       ↓
   * todayTodos
   *
   * 这样用户点击按钮后不需要等待 refresh
   * 才看到视觉变化。
   */
  const [
    movedIds,
    setMovedIds,
  ] =
    useState<
      Set<string>
    >(
      () =>
        new Set()
    );

  const [
    error,
    setError,
  ] =
    useState<
      string | null
    >(null);


  /**
   * 把一个过期 Todo 移回今天。
   */
  async function moveToToday(
    todo: Todo
  ) {
    if (
      movingId ||
      todo.task_date ===
        todayDate
    ) {
      return;
    }

    setMovingId(
      todo.id
    );

    setError(
      null
    );

    try {
      const supabase =
        createClient();

      const {
        error:
          updateError,
      } =
        await supabase
          .from(
            "todos"
          )
          .update({
            /*
             * 这里只修改 Todo 属于哪一天。
             */
            task_date:
              todayDate,
          })
          .eq(
            "id",
            todo.id
          );


      if (
        updateError
      ) {
        setError(
          "移动任务失败：" +
            updateError.message
        );

        return;
      }


      /*
       * Optimistic UI：
       * 成功写数据库后立刻从 overdue 区域隐藏。
       */
      setMovedIds(
        (current) => {
          const next =
            new Set(
              current
            );

          next.add(
            todo.id
          );

          return next;
        }
      );


      /*
       * 重新执行 Todo server page。
       *
       * 这个 Todo 会自动：
       *
       * overdueTodos
       *      ↓
       * todayTodos
       */
      router.refresh();
    } catch (
      unknownError
    ) {
      const message =
        unknownError instanceof
        Error
          ? unknownError.message
          : String(
              unknownError
            );

      setError(
        "移动任务失败：" +
          message
      );
    } finally {
      setMovingId(
        null
      );
    }
  }


  /*
   * 已经成功移动的 Todo
   * 暂时不再显示在 overdue 区域。
   */
  const visibleTodos =
    todos.filter(
      (todo) =>
        !movedIds.has(
          todo.id
        )
    );


  if (
    visibleTodos.length ===
    0
  ) {
    return (
      <div className="rounded-2xl bg-sage-50 px-4 py-5 text-center">
        <p className="text-sm font-medium text-sage-700">
          都处理好了
        </p>

        <p className="mt-1 text-xs text-ink-faint">
          想继续做的任务已经移到今天。
        </p>
      </div>
    );
  }


  return (
    <div className="space-y-3">
      {error && (
        <div className="rounded-xl bg-blush-50 px-3 py-2 text-xs text-blush-500">
          {error}
        </div>
      )}


      {visibleTodos.map(
        (todo) => {
          const moving =
            movingId ===
            todo.id;

          return (
            <div
              key={
                todo.id
              }
              className="space-y-2"
            >
              {/*
               * 原来的 Todo UI 完全复用。
               *
               * 因此：
               * - 完成
               * - 编辑
               * - 删除
               * - Focus
               * - Subtasks
               *
               * 都保持原来的逻辑。
               */}
              <TodoList
                todos={[
                  todo,
                ]}
              />


              {/*
               * 这个按钮只存在于 overdue 区域。
               */}
              <div className="flex justify-end px-2">
                <button
                  type="button"
                  disabled={
                    moving
                  }
                  onClick={() =>
                    void moveToToday(
                      todo
                    )
                  }
                  className="inline-flex h-8 items-center gap-1.5 rounded-xl bg-sage-50 px-3 text-[11px] font-medium text-sage-700 transition hover:bg-sage-100 disabled:cursor-wait disabled:opacity-50"
                >
                  {moving ? (
                    <>
                      <LoaderCircle className="h-3.5 w-3.5 animate-spin" />

                      移动中…
                    </>
                  ) : (
                    <>
                      移到今天

                      <ArrowRight className="h-3.5 w-3.5" />
                    </>
                  )}
                </button>
              </div>
            </div>
          );
        }
      )}
    </div>
  );
}